{
  "name": "losty",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write app src app.config.ts tsconfig.json package.json eslint.config.js jest.config.js .prettierrc.json pnpm-workspace.yaml",
    "format:check": "prettier --check app src app.config.ts tsconfig.json package.json eslint.config.js jest.config.js .prettierrc.json pnpm-workspace.yaml",
    "test": "jest"
  },
  "dependencies": {
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "globals": "^17.14.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "prettier": "^3.10.1",
    "react-native-svg-transformer": "^1.5.3",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  }
}
